# ── Telegram ──────────────────────────────────────────────
TELEGRAM_TOKEN=tu_token_aqui

# ── Proveedor de IA: "ollama" (local) o "groq" (nube) ────
AI_PROVIDER=ollama

# ── Ollama (solo si AI_PROVIDER=ollama) ───────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Groq (solo si AI_PROVIDER=groq) ──────────────────────
# Obtener gratis en: https://console.groq.com
GROQ_API_KEY=tu_groq_api_key_aqui
GROQ_MODEL=llama-3.1-8b-instant

# ── WordPress ─────────────────────────────────────────────
WP_URL=https://codigosamurai.cl
WP_USER=tu_usuario_wp
WP_APP_PASSWORD=tu_application_password
